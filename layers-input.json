{
    "catalog": "https://s3-west.nrp-nautilus.io/public-data/stac/catalog.json",
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "plugins": [
        {
            "url": "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v3.51.0/core/plugins/mcp.js",
            "options": {
                "url": "https://duckdb-mcp.nrp-nautilus.io/mcp",
                "prompt": "geospatial-analyst"
            }
        },
        "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v3.51.0/core/plugins/hex.js",
        "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v3.51.0/core/plugins/charts.js",
